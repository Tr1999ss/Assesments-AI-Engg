# --- LLM Provider Configuration ---
# Set PROVIDER to "openrouter" to use cloud models, or "ollama" for local.
PROVIDER=openrouter

# OpenRouter settings
OPENROUTER_API_KEY=xxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-2.5-flash

# Ollama settings (used when PROVIDER=ollama)
OLLAMA_CHAT_MODEL=gemma4:latest